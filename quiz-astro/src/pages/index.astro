---
import QuizLayout from '@/layouts/QuizLayout.astro';

// "Begin Quiz" CTAs route into the question flow.
// base: '/quiz/' is applied by Astro automatically to relative <a href> values
// rendered through Astro components, but for plain <a> tags we write the
// absolute path explicitly so behavior is unambiguous regardless of base.
const beginHref = '/quiz/take/';
---
<QuizLayout
  title="Free Quiz | Amari Method"
  description="A short Amari intake for pain or restriction that keeps coming back. Answer twelve questions and get a clear next step. Free, about three minutes."
  canonical="https://www.amarimethod.com/quiz"
>
  <div class="topbar quiz-cover-bar">
    <div class="row">
      <a class="quiz-wordmark" href="https://www.amarimethod.com/">
        <img src="/images/identity/amari-method-wordmark.svg" alt="Amari Method" />
      </a>
      <span class="meta">Pain pattern quiz</span>
    </div>
    <div class="rail"><div class="rail-fill" style="right:100%"></div></div>
  </div>

  <main class="quiz-cover">
    <section class="quiz-cover-panel screen">
      <div class="quiz-cover-copy">
      <span class="kicker eyebrow">A short Amari intake</span>
      <h1>Why does this keep coming back?</h1>
      <p class="lede">Answer twelve questions about the pain or restriction you are dealing with. You’ll get a clearer read on the pattern your body may be working around—and a direct next step if Amari looks relevant.</p>
      <div class="go">
        <a class="btn" href={beginHref}>Take the quiz <span class="arrow">→</span></a>
      </div>
      </div>
      <div class="facts">
        <div class="f"><b>12</b><span>Questions</span></div>
        <div class="f"><b>3 min</b><span>To complete</span></div>
        <div class="f"><b>Private</b><span>Your answers</span></div>
      </div>
    </section>
  </main>

  <footer class="qfoot">Amari Method · Pain pattern quiz</footer>

  <script is:inline>
    // Affiliate ?ref= capture. The legacy React quiz read ?ref from window.location
    // and persisted it to localStorage on mount. The static cover has no React, so we
    // do the same persistence here and forward the param to the Begin Quiz links
    // so the React island at /quiz/take/ also sees it on first visit.
    (function () {
      try {
        var params = new URLSearchParams(window.location.search);
        var ref = params.get('ref');
        if (ref) {
          localStorage.setItem('quiz_ref', ref);
          var encoded = encodeURIComponent(ref);
          document.querySelectorAll('a[href="/quiz/take/"]').forEach(function (a) {
            a.setAttribute('href', '/quiz/take/?ref=' + encoded);
          });
        }
      } catch (e) {}
    })();
  </script>
</QuizLayout>
