{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://amarimethod.com/schemas/automation-truth-envelope.v1.json",
  "title": "TruthEnvelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["assertionId", "claim", "authority", "authorityKind", "authorityPresent", "proofLevel", "valueKind", "value", "sourceRefs", "window", "asOf", "watermark", "coverage", "freshness", "ambiguity", "status", "safetyViolation", "onMissing", "onStale", "reasonCodes", "limitations"],
  "properties": {
    "assertionId": { "type": "string", "minLength": 1 }, "claim": { "type": "string", "minLength": 1 },
    "authority": { "enum": ["WorkflowSpec", "CompiledPlan", "ReleaseManifest", "DeploymentRecord", "ExecutionLedger", "ExternalObservation", "DerivedStatusPolicy"] },
    "authorityKind": { "enum": ["system", "provider", "human", "ai"] }, "authorityPresent": { "type": "boolean" },
    "proofLevel": { "enum": ["exact", "estimated", "unknown"] }, "valueKind": { "enum": ["known", "unknown"] }, "value": {},
    "sourceRefs": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["kind", "id"], "properties": { "kind": { "type": "string", "minLength": 1 }, "id": { "type": "string", "minLength": 1 }, "digest": { "type": "string", "minLength": 1 } } } },
    "window": { "type": "object", "additionalProperties": false, "required": ["start", "end", "timezone"], "properties": { "start": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }, "end": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }, "timezone": { "type": "string", "minLength": 1 } } },
    "asOf": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }, "watermark": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" },
    "coverage": { "type": "object", "additionalProperties": false, "required": ["expected", "observed", "missing", "paginationComplete", "sampleRate"], "properties": { "expected": { "type": "integer", "minimum": 0 }, "observed": { "type": "integer", "minimum": 0 }, "missing": { "type": "integer", "minimum": 0 }, "paginationComplete": { "type": "boolean" }, "sampleRate": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "freshness": { "type": "object", "additionalProperties": false, "required": ["checkedAt", "maxAgeMs", "state"], "properties": { "checkedAt": { "type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$" }, "maxAgeMs": { "type": "integer", "minimum": 0 }, "state": { "enum": ["fresh", "stale", "unavailable"] } } },
    "ambiguity": { "enum": ["none", "present", "unknown"] }, "status": { "enum": ["Broken", "Unknown", "Degraded", "Healthy"] }, "safetyViolation": { "type": "boolean" },
    "onMissing": { "enum": ["Unknown", "Degraded", "Broken"] }, "onStale": { "enum": ["Unknown", "Degraded", "Broken"] },
    "reasonCodes": { "type": "array", "items": { "type": "string", "minLength": 1 } }, "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    { "if": { "properties": { "proofLevel": { "const": "exact" } }, "required": ["proofLevel"] }, "then": { "properties": { "coverage": { "properties": { "paginationComplete": { "const": true }, "sampleRate": { "const": 1 } }, "required": ["paginationComplete", "sampleRate"] } } } },
    { "if": { "properties": { "valueKind": { "const": "unknown" } }, "required": ["valueKind"] }, "then": { "properties": { "proofLevel": { "const": "unknown" }, "value": { "type": "null" }, "status": { "const": "Unknown" } } } },
    { "if": { "properties": { "valueKind": { "const": "known" } }, "required": ["valueKind"] }, "then": { "properties": { "value": { "not": { "type": "null" } } } } },
    { "if": { "properties": { "authorityKind": { "enum": ["human", "ai"] }, "claim": { "enum": ["Live", "Healthy"] } }, "required": ["authorityKind", "claim"] }, "then": false }
  ]
}
