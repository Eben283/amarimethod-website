{
  "name": "amari-followup-capture-control-rehearsal",
  "main": "src/control.mjs",
  "account_id": "fa2b6f2441129b259dd5dea74045721b",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "observability": {
    "enabled": false
  },
  "send_metrics": false,
  "keep_vars": false,
  "limits": {
    "cpu_ms": 1000,
    "subrequests": 64
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REGISTRY",
        "class_name": "FollowUpRehearsalRegistryV1"
      }
    ]
  },
  "migrations": [
    {
      "tag": "rehearsal-v1",
      "new_sqlite_classes": [
        "FollowUpRehearsalRegistryV1"
      ]
    }
  ],
  "r2_buckets": [
    {
      "binding": "CAPTURE_BUCKET",
      "bucket_name": "amari-followup-evidence-rehearsal",
      "jurisdiction": "us"
    }
  ],
  "services": [
    {
      "binding": "ISSUER",
      "service": "amari-followup-admission-issuer-rehearsal",
      "entrypoint": "FollowUpRehearsalIssuer"
    }
  ]
}
