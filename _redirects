# Astro static output for quiz — serves /quiz/index.html (cover) and
# /quiz/take/index.html (assessment) natively. SPA fallback removed
# because Astro emits both routes as static HTML; the previous wildcard
# would intercept /quiz/take and serve the cover instead.

# SPA fallback for client portal
/portal/* /portal/index.html 200

# SPA fallback for staff dashboard — explicit routes ONLY.
# Wildcard /staff/* catches /staff/assets/*.js and serves HTML, which
# breaks the SPA bundle load. Target is /staff/ (not /staff/index.html)
# to avoid Cloudflare's trailing-slash canonicalization.
/staff/messages /staff/ 200
/staff/balances /staff/ 200
/staff/clients /staff/ 200
/staff/client/* /staff/ 200
/staff/playbook /staff/ 200
/staff/outreach /staff/ 200
/staff/partners /staff/ 200
/staff/check-in/* /staff/ 200
/staff/funnel /staff/ 200
/staff/login /staff/ 200

# SPA fallback for chief of staff
/cos/* /cos/index.html 200

# Optional: Redirect old subdomain to new path (activate after DNS update)
# https://quiz.amarimethod.com/* https://www.amarimethod.com/quiz/:splat 301

# === Booking redirects ===
# Phase 1 cutover (commit-after this one): initial-in-person + initial-
# virtual now route to the native booking flow at /book/<variant>. The
# native flow uses GHL payment links for payment so cards still save to
# the GHL contact's native Payment Methods panel.
/book-initial-in-person /book/initial-in-person 301
/book-initial-virtual /book/initial-virtual 301
# Discovery call now uses the native flow at /book/discovery-call (free
# booking — appointment created directly via GHL Calendar API, no Stripe).
# Follow-ups are pre-purchased via 4/8-session packages, so legacy
# /book-follow-up URLs land at the portal where series clients book their
# pre-paid sessions via the in-portal BookingModal (no separate $190 path).
/book-follow-up /portal/ 301
/book-follow-up-virtual /portal/ 301
/book-discovery-call /book/discovery-call 301

